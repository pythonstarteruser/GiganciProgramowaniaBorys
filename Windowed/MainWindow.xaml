<Window x:Class="MiniMusicRandomizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini Music Randomizer"
        Width="600"
        Height="400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tytuł -->
        <TextBlock Text="🎵 Mini Music Randomizer"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,25"/>

        <!-- Główna część -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center">

            <Button Content="📁 Wybierz folder z muzyką"
                    Width="250"
                    Height="45"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20"
                    Click="ChooseFolder_Click"/>

            <Border BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="20,0">

                <TextBlock Text="Nie wylosowano jeszcze żadnego utworu"
                           FontSize="18"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </Border>

            <Button Content="🎲 LOSUJ UTWÓR"
                    Width="200"
                    Height="50"
                    FontSize="16"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Margin="0,25,0,0"/>

        </StackPanel>

        <!-- Przyciski odtwarzania -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0">

            <Button Content="▶ Odtwórz"
                    Width="100"
                    Height="35"
                    Margin="5"/>

            <Button Content="⏸ Pauza"
                    Width="100"
                    Height="35"
                    Margin="5"/>

            <Button Content="⏹ Stop"
                    Width="100"
                    Height="35"
                    Margin="5"/>

        </StackPanel>

    </Grid>

</Window>